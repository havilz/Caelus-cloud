# ==============================================================================
# CAELUS CLOUD - LOCAL ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=caelus-cloud-api
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=true
APP_LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase Dev / Local Postgres)
# ------------------------------------------------------------------------------
# Masukkan kredensial Supabase / PostgreSQL lokal Anda di bawah ini:
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.uyqoyqeiwuzujeqpwnzl
DB_PASSWORD=aCHRCLkNXtHbusQN
DB_NAME=postgres
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ------------------------------------------------------------------------------
# 3. CACHE & MESSAGE BROKER (Upstash Dev / Local Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. SECURITY, JWT & AUTHENTICATION (Auto-Generated Cryptographic Keys)
# ------------------------------------------------------------------------------
JWT_SECRET=7dc04e2c8cde46c3aa4788f60f912c4fff41ab5396c747ecbf9f99853391472a
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=2ad69b09d78f42228c74e54bd39b8c2e17f136f34bb94b67a3e3612549781d94

# Parameter Password Hashing (Argon2id)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# ------------------------------------------------------------------------------
# 5. STORAGE SERVICE
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=caelus-storage
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_URL=http://localhost:3100
