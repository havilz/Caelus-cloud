# ==============================================================================
# CAELUS CLOUD - LOCAL ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME=caelus-cloud-api
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=true
APP_LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=*
TRUSTED_PROXIES=127.0.0.1,::1
ALLOWED_VOLUME_ROOTS=/var/lib/caelus/volumes,/opt/caelus/volumes

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Local Postgres / External Managed DB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=caelus_user
DB_PASSWORD=caelus_password
DB_NAME=caelus_cloud_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ------------------------------------------------------------------------------
# 3. CACHE & MESSAGE BROKER (Upstash Dev / Local Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. SECURITY, JWT & AUTHENTICATION (Cryptographic Keys)
# ------------------------------------------------------------------------------
# Generate keys with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=your_encryption_key_here

# Parameter Password Hashing (Argon2id)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# ------------------------------------------------------------------------------
# 5. STORAGE SERVICE
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=caelus-storage
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_URL=http://localhost:3100
