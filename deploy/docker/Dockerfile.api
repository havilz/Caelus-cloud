# Stage 1: Build binary
FROM golang:alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /app/bin/caelus-api ./cmd/api/main.go

# Stage 2: Runtime image
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata docker-cli

WORKDIR /app

COPY --from=builder /app/bin/caelus-api /app/caelus-api
COPY --from=builder /app/migrations /app/migrations

EXPOSE 8080

ENTRYPOINT ["/app/caelus-api"]
